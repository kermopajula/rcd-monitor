# IP (or hostname) of the pool heater on the local network. Required.
heaterIp=192.168.1.50

# How often to ping (minutes), how many consecutive failures before alerting,
# and how often to remind while it stays down (minutes).
checkMinutes=5
failureThreshold=2
reminderMinutes=60

# HTTP API for status / mute / unmute / test. Requests must carry
# "Authorization: Bearer <apiToken>". Leave apiToken empty to allow unauthenticated LAN access.
port=3001
apiToken=

# ntfy push notifications (https://ntfy.sh). ntfyToken only for protected topics.
ntfyUrl=https://ntfy.sh
ntfyTopic=
ntfyToken=

# Resend email (https://resend.com). notifyEmailTo may be a comma separated list.
resendApiKey=
notifyEmailFrom=Pool Heater <alerts@yourdomain.com>
notifyEmailTo=
